# Application
APP_NAME=kirana
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here

# API Authentication
KIRANA_API_KEY=kirana-default-api-key-change-me

# Admin Panel
ADMIN_PASSWORD=your-admin-password

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=kirana
DB_PASS=kirana
DB_NAME=kirana
# DATABASE_URL=postgresql+asyncpg://kirana:kirana@localhost:5432/kirana

# Database Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# Default LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# LLM Settings
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# RAG Pipeline
RAG_ENABLED=true
RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBED_DIM=384
RAG_CHUNK_MAX_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_TOP_K=10
RAG_MAX_CONTEXT_CHARS=12000
RAG_EMBED_BATCH_SIZE=32

# LiteParse Document Parsing
LITEPARSE_ENABLED=true
LITEPARSE_OCR_LANGUAGE=ind
LITEPARSE_MAX_PAGES=1000
LITEPARSE_DPI=150

# Vision API for image/Excel analysis (optional — falls back to OPENAI_API_KEY + DEFAULT_MODEL)
ZAI_API_KEY=
ZAI_VISION_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_VISION_MODEL=glm-4.6v

# Upload directory for knowledge files
UPLOAD_DIR=/app/uploads

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Session Management
SESSION_EXPIRY_DAYS=3
SESSION_DELETION_DAYS=7
SESSION_CLEANUP_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=INFO
